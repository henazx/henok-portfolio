# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of the deployed site. Used for canonical links, sitemap and
# Open Graph metadata. Set this in Vercel to your production domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Contact form (optional)
# ---------------------------------------------------------------------------
# The form works out of the box using a mailto fallback. To deliver messages
# server-side, create a free Resend account and set the three variables below.
# https://resend.com
RESEND_API_KEY=
CONTACT_TO_EMAIL=henokneknikiezx@gmail.com
# Must be a sending address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@your-domain.com>

# ---------------------------------------------------------------------------
# Visual editor publishing (required for "Publish" to work)
# ---------------------------------------------------------------------------
# Create a GitHub personal access token with "Contents: read and write" on
# this repository, then add these variables in Vercel (and locally if needed).
# The editor is unlocked by typing the keyword: Henok
GITHUB_TOKEN=
# Format: owner/repository-name, e.g. henazx/portfolio
GITHUB_REPO=
# Branch that Vercel deploys from. Defaults to main.
GITHUB_BRANCH=main
# Optional override for the editable content file.
GITHUB_CONTENT_PATH=data/content.json
