# Copy to .env.local for local development. Every value below is a PLACEHOLDER.
# Never commit a file containing real secrets; .env* is ignored by Git.

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Preferred. On Vercel, VERCEL_URL is detected automatically if this is unset.
SITE_URL=https://your-domain.com
# Legacy alias, still supported for older deployments.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Visual editor authentication (required for Publish)
# ---------------------------------------------------------------------------
# Checked only on the server. Use a long, random value; the editor keyword
# "Henok" merely opens the password dialog and is not a credential.
PUBLISH_PASSWORD=replace-with-a-long-random-password
# Optional but recommended. Rotating this signs out every active session.
PUBLISH_SESSION_SECRET=replace-with-a-long-random-signing-secret

# ---------------------------------------------------------------------------
# GitHub publishing
# ---------------------------------------------------------------------------
# Fine-grained token with Contents: read and write on the repository only.
GITHUB_TOKEN=your_github_token_here
# Format: owner/repository-name
GITHUB_REPO=owner/repository-name
# Branch that Vercel deploys from. Defaults to main.
GITHUB_BRANCH=main
# Optional override for the editable content file.
GITHUB_CONTENT_PATH=data/content.json

# ---------------------------------------------------------------------------
# Rate limiting (optional but recommended on Vercel)
# ---------------------------------------------------------------------------
# Without a shared store, limits are per serverless instance only. Use an
# Upstash Redis REST database directly, or the equivalent Vercel KV aliases.
UPSTASH_REDIS_REST_URL=https://your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Alternative names supplied by the Vercel KV integration:
# KV_REST_API_URL=https://your-kv-rest-url
# KV_REST_API_TOKEN=your-kv-rest-token

# ---------------------------------------------------------------------------
# Contact form (required for delivery)
# ---------------------------------------------------------------------------
# All three values must be set for the form to deliver email. The route returns
# a configuration error rather than pretending a message was sent.
RESEND_API_KEY=your_resend_api_key
CONTACT_TO_EMAIL=you@example.com
# Must be a sending address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Portfolio Contact <contact@your-domain.com>
